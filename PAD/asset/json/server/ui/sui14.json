                    "",
                    "// 玩法集成测试：显示棋盘 → 拖拽消除 → 倒计时结束 → 输出结算结果\r\n// PADPuzzle.bgImage = \"asset/image/picture/QY/俄罗斯方块/背景图.png\"; // 可选背景\r\nlet puzzle = new PADPuzzle({\r\n    cols: 6,\r\n    rows: 6,\r\n    elementWidth: 100,\r\n    elementHeight: 100,\r\n    gap: 8,\r\n    roundTime: 10000 // 10 秒限时回合\r\n});\r\npuzzle.start(\r\n    function (result: PADPuzzleResult) {\r\n        console.log(\"=== 结算结果 ===\");\r\n        console.log(\"最大连锁:\", result.maxComboCount);\r\n        console.log(\"消除珠子:\", result.totalBallCount);\r\n        console.log(\"各属性:\", JSON.stringify(result.byType));\r\n        // 同时可从 PADPuzzle.lastResult 读取（供后续指令）\r\n    },\r\n    function () {\r\n        console.log(\"=== 时间到 ===\");\r\n    }\r\n);\r\nPADBattle.PADgame=puzzle;\r\n// 主动结束（如战斗中需要提前关闭）：\r\n// puzzle.dispose();",
