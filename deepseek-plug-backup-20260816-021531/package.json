{
  "name": "dsh-write-touch",
  "version": "0.1.0",
  "description": "DSH host plugin: after write/edit lands, emit FILE_NOTIFY_CHANGE_LAST_WRITE so editors (e.g. GameCreator) recompile without a restart.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
